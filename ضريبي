javascript:(function(){    const d = document;    const mob = "0540450694";    const mobFormatted = "+966" + mob.replace(/^(0|966|\+966)/, '');    const triggerInput = (selector, value) => {        const el = d.querySelector(selector);        if (el) {            const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;            setter.call(el, value);            el.dispatchEvent(new Event('input', { bubbles: true }));            el.dispatchEvent(new Event('change', { bubbles: true }));        }    };    triggerInput('input[name="poaNumber"]', '477013494');    triggerInput('input[name="Identity"]', '1096035066');    triggerInput('input[name="DateOfBirth"]', '1418-04-11');    triggerInput('input[name="email"]', 'test@mail.com');    triggerInput('input[type="tel"]', mobFormatted);    setTimeout(() => {        const vBtn = Array.from(d.querySelectorAll('button')).find(b =>             b.innerText.includes('التحقق') || b.classList.contains('bg-bluerega')        );        if (vBtn) vBtn.click();    }, 300);})();
