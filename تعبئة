javascript:(function(){const d=document,old=d.getElementById('pro-auto-container');if(old)old.remove();const s=d.createElement('style');s.innerHTML='#pro-auto-container{position:fixed;top:40px;right:40px;width:320px;background:#ffffff;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.25);z-index:2147483647;font-family:sans-serif;direction:rtl;text-align:right;border:1px solid #cbd5e1;overflow:hidden;}.h{background:#1a3b7a;padding:12px;color:#fff;cursor:move;display:flex;justify-content:space-between;font-weight:bold;font-size:14px;}.b{padding:15px;}.spin{width:20px;height:20px;border:2px solid #e2e8f0;border-bottom-color:#2563eb;border-radius:50%;display:inline-block;animation:r 1s linear infinite;}@keyframes r{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}';d.head.appendChild(s);const c=d.createElement('div');c.id='pro-auto-container';c.innerHTML='<div class="h" id="drag"><span>⚡ أتمتة الخطوات والتعليق الذكي</span><span style="cursor:pointer" onclick="this.parentElement.parentElement.remove()">✕</span></div><div class="b" id="main"><div style="text-align:center;padding:20px 0;"><span class="spin"></span><div id="st" style="margin-top:10px;font-size:13px;color:#1e293b;">جاري بدء الخطوات التمهيدية...</div></div></div>';d.body.appendChild(c);let isD=false,off={x:0,y:0};const h=d.getElementById('drag');h.onmousedown=(e)=>{isD=true;off.x=e.clientX-c.offsetLeft;off.y=e.clientY-c.offsetTop;};d.onmousemove=(e)=>{if(isD){c.style.left=(e.clientX-off.x)+"px";c.style.top=(e.clientY-off.y)+"px";c.style.right="auto";}};d.onmouseup=()=>isD=false;const slp=(ms)=>new Promise(r=>setTimeout(r,ms));const wf=async(fn,t=5000,iv=50)=>{const st=Date.now();while(Date.now()-st<t){const r=fn();if(r)return r;await slp(iv);}return null;};const typeEffect=async(sel,val,spd=10)=>{const els=d.querySelectorAll(sel);if(!els.length)return;const el=els[els.length-1];el.focus();const set=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,"value").set;set.call(el,"");el.dispatchEvent(new Event("input",{bubbles:true}));for(let i=0;i<val.length;i++){const cur=val.slice(0,i+1);set.call(el,cur);el.dispatchEvent(new Event("input",{bubbles:true}));el.dispatchEvent(new KeyboardEvent("keydown",{bubbles:true,key:val[i]}));el.dispatchEvent(new KeyboardEvent("keypress",{bubbles:true,key:val[i]}));el.dispatchEvent(new KeyboardEvent("keyup",{bubbles:true,key:val[i]}));await slp(spd);}el.dispatchEvent(new Event("change",{bubbles:true}));el.blur();};const pasteDate=async(sel,val)=>{const els=d.querySelectorAll(sel);if(!els.length)return;const el=els[els.length-1];el.focus();await slp(50);const set=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,"value").set;set.call(el,val);el.dispatchEvent(new Event("input",{bubbles:true}));el.dispatchEvent(new Event("change",{bubbles:true}));try{const dt=new DataTransfer();dt.setData("text/plain",val);el.dispatchEvent(new ClipboardEvent("paste",{bubbles:true,cancelable:true,clipboardData:dt}));}catch(e){}await slp(100);el.blur();await slp(100);};async function sSel(lbl,opt){const t=Array.from(d.querySelectorAll("p,label,span,div")).reverse().find(el=>el.textContent.trim()===lbl);if(!t)return;const ctrl=t.closest("div").querySelector('[class*="-control"]');if(ctrl){ctrl.dispatchEvent(new MouseEvent("mousedown",{bubbles:true}));await slp(300);const m=await wf(()=>d.querySelector('[class*="-menu"]'),1500,20);if(m){const o=await wf(()=>Array.from(m.querySelectorAll('[id*="-option"]')).find(x=>x.textContent.trim()===opt),1500,20);if(o){await slp(100);o.click();await slp(200);}}}}async function start(){const v_m="0540450694",v_e="a@a.com";const WAIT_VERIFY=5000,WAIT_NEW=2500;const hrs=[{id:"1062757339",dob:"1409-11-17"},{id:"1089508376",dob:"1416-08-24"},{id:"1072844564",dob:"1412-01-28"},{id:"1106598384",dob:"1420-10-17"},{id:"1030530842",dob:"1380-07-12"}];const updateStatus=(txt)=>{const el=d.getElementById("st");if(el)el.innerText=txt;};updateStatus("جاري الضغط على: التصرفات العقارية");const bTasarafat=await wf(()=>Array.from(d.querySelectorAll("button")).find(b=>b.innerText.trim().includes("التصرفات العقارية")));if(bTasarafat){bTasarafat.click();await slp(800);}updateStatus("جاري الضغط على أيقونة الطلب");const imgReq=await wf(()=>d.querySelector('img[src*="Request icon.svg"]')||d.querySelector('img[alt="me"]'));if(imgReq){imgReq.click();await slp(800);}updateStatus("جاري الضغط على: التأكيد");const bTakeed=await wf(()=>Array.from(d.querySelectorAll("button")).find(b=>b.innerText.trim().includes("التأكيد")));if(bTakeed){bTakeed.click();}updateStatus("الانتظار لمدة 3 ثوانٍ للاستقرار...");await slp(3000);updateStatus("جاري الضغط على: إضافة مالك جديد");const bAddNewInit=await wf(()=>Array.from(d.querySelectorAll("button")).reverse().find(b=>b.innerText.includes("إضافة مالك جديد")));if(bAddNewInit){bAddNewInit.click();await slp(WAIT_NEW);}for(let k=0;k<hrs.length;k++){updateStatus(`تعبئة الوارث ${k+1} من ${hrs.length} (الهوية: ${hrs[k].id})`);await sSel("نوع المالك","فرد");await sSel("نوع الهوية","هوية وطنية");await typeEffect('input[name="Identity"]',hrs[k].id,10);await pasteDate('input[name="DateOfBirth"]',hrs[k].dob);await typeEffect('input[name="email"]',v_e,10);await typeEffect('input[type="tel"]',"+966"+v_m.substring(1),10);await slp(400);const vB=Array.from(d.querySelectorAll("button")).reverse().find(b=>b.innerText.includes("التحقق"));if(vB){vB.click();let isVerified=false;for(let i=0;i<30;i++){await slp(500);const checkInputs=d.querySelectorAll('input[name="Identity"]');const lastInput=checkInputs[checkInputs.length-1];if(!d.body.contains(vB)||vB.disabled||(lastInput&&lastInput.disabled)){isVerified=true;break;}}if(!isVerified){await slp(WAIT_VERIFY);}await slp(1200);}if(k<hrs.length-1){const ad=Array.from(d.querySelectorAll("button")).reverse().find(b=>b.innerText.includes("إضافة مالك جديد"));if(ad){ad.click();await slp(WAIT_NEW);}}}const stEl=d.getElementById("st");if(stEl)stEl.innerHTML="<b style='color:#16a34a;'>اكتملت العملية بنجاح وبأمان تام ✅</b>